rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    match /users/{uid} {
      allow read: if isOwner(uid);

      // Bootstrap only: a user may create their OWN profile once, and only
      // with the fixed free-tier defaults. plan/powermoney are never
      // client-chosen — any upgrade comes from the backend (the Stripe
      // webhook at apps/web/app/api/stripe/webhook, using the Admin SDK,
      // which bypasses these rules entirely).
      allow create: if isOwner(uid)
        && request.resource.data.plan == 'free'
        && request.resource.data.powermoney == 20
        && request.resource.data.keys().hasOnly([
             'name', 'email', 'plan', 'powermoney', 'powermoneyResetAt',
             'preferences', 'createdAt', 'updatedAt'
           ]);

      // The owner can update their own profile, but never the plan/usage/
      // billing fields — those stay backend-only.
      allow update: if isOwner(uid)
        && !request.resource.data.diff(resource.data).affectedKeys()
              .hasAny(['plan', 'powermoney', 'powermoneyResetAt',
                       'stripeCustomerId', 'stripeSubscriptionId']);

      allow delete: if false;

      match /notes/{noteId} {
        allow read, write: if isOwner(uid);
      }

      match /tasks/{taskId} {
        allow read, write: if isOwner(uid);
      }

      match /flashcardDecks/{deckId} {
        allow read, write: if isOwner(uid);

        match /cards/{cardId} {
          allow read, write: if isOwner(uid);
        }
      }

      match /history/{entryId} {
        allow read, write: if isOwner(uid);
      }

      match /studySessions/{sessionId} {
        allow read, write: if isOwner(uid);
      }
    }

    // Deny everything else by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
