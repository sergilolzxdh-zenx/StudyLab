# Copy the values you have into apps/web/.env.local. Never commit an actual
# .env file — only this template. Nothing here is invented; every value
# below must come from you.
#
# Architecture note: the AI backend runs as Next.js Route Handlers
# (apps/web/app/api/*), NOT Firebase Cloud Functions — Cloud Functions
# require the Blaze (paid) plan just to deploy, even with zero usage, and
# this project stays on the free Spark plan. Route Handlers deploy for
# free on Vercel (or any Node host) and use Firebase Admin SDK with a
# service account instead.

# --- Firebase (client SDK, apps/web) -----------------------------------
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# --- Firebase Admin (server-only, apps/web/app/api/*) ---------------------
# From Firebase Console → Project settings → Service accounts → Generate
# new private key. FIREBASE_ADMIN_PRIVATE_KEY keeps its \n escapes as-is —
# the code unescapes them. Not needed for local dev against the Firestore
# emulator (see FIRESTORE_EMULATOR_HOST below) — only for real deploys.
FIREBASE_ADMIN_PROJECT_ID=
FIREBASE_ADMIN_CLIENT_EMAIL=
FIREBASE_ADMIN_PRIVATE_KEY=

# --- Local development only ------------------------------------------------
# Uncomment to run against `firebase emulators:start --only firestore,auth`
# instead of real production data. No FIREBASE_ADMIN_* needed while this is set.
# FIRESTORE_EMULATOR_HOST=127.0.0.1:8080

# --- Stripe (server-only) -------------------------------------------------
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID_PRO=
STRIPE_PRICE_ID_PREMIUM=

# --- Google Gemini (server-only, never exposed to the client) ------------
# From aistudio.google.com/apikey — NOT the Firebase apiKey above, that's a
# different key even though both start with "AIzaSy".
GEMINI_API_KEY=
