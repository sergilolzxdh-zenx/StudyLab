# Copy to apps/web/.env.local (client) and functions/.env (server) once real
# values exist. Never commit an actual .env file — only this template.
# Nothing here is invented; every value below must come from you.

# --- Firebase (client SDK, apps/web) -----------------------------------
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# --- Firebase Admin (Cloud Functions, server-only) ----------------------
# Local emulator use only — deployed functions use the platform's
# built-in service account, never a checked-in key file.
GOOGLE_APPLICATION_CREDENTIALS=

# --- Stripe (server-only) -------------------------------------------------
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID_PRO=
STRIPE_PRICE_ID_PREMIUM=

# --- Google Gemini (server-only, never exposed to the client) ------------
# From aistudio.google.com/apikey — NOT the Firebase apiKey above, that's a
# different key even though both start with "AIzaSy".
GEMINI_API_KEY=
